    },
    {
      "index": 41,
      "locator": "Notebook 单元 41 · code",
      "text": "X0=pd.DataFrame([[8,7.5,65]])\nprint('线性判别分类情况：',d123_lda.predict(X0)) "
    },
    {
      "index": 42,
      "locator": "Notebook 单元 42 · code",
      "text": "d123_qda=qda(priors=(1/3,1/3,1/3)).fit(X,Y)\nd123['qd_G'] = d123_qda.predict(X) #非线性判别结果\nprint(d123)"
    },
    {
      "index": 43,
      "locator": "Notebook 单元 43 · code",
      "text": "M2=d123.pivot_table('id','G','qd_G',aggfunc=len,margins=True,fill_value='0')\nprint('混淆矩阵:\\n',M2)"
    },
    {
      "index": 44,
      "locator": "Notebook 单元 44 · code",
      "text": "Rate(M2)"
    },
    {
      "index": 45,
      "locator": "Notebook 单元 45 · code",
      "text": "print('非线性判别分类情况：',d123_qda.predict(X0)) "
    },
    {
