    {
      "index": 7,
      "locator": "Notebook 单元 7 · markdown",
      "text": "### 12.2.1 Fisher判别的提出"
    },
    {
      "index": 8,
      "locator": "Notebook 单元 8 · markdown",
      "text": "### 12.2.2 线性判别函数"
    },
    {
      "index": 9,
      "locator": "Notebook 单元 9 · code",
      "text": "#%run init.py"
    },
    {
      "index": 10,
      "locator": "Notebook 单元 10 · code",
      "text": "import pandas as pd                     \npd.set_option('display.precision',4)\npd.set_option('display.max_rows',20)       "
    },
    {
      "index": 11,
      "locator": "Notebook 单元 11 · code",
      "text": "d121=pd.read_excel('mvsData.xlsx','d121');print(d121)"
    },
    {
      "index": 12,
      "locator": "Notebook 单元 12 · code",
      "text": "d121.boxplot(column=['x1','x2'],by='G');"
    },
    {
      "index": 13,
      "locator": "Notebook 单元 13 · code",
      "text": "#G1=d121[d121.G==1];G2=d121[d121.G==2];"
    },
    {
      "index": 14,
      "locator": "Notebook 单元 14 · code",
      "text": "from scipy import stats as st\n#st.levene(G1.x1,G2.x1)#方差齐性检验"
    },
    {
      "index": 15,
      "locator": "Notebook 单元 15 · code",
      "text": "t1=st.ttest_ind(d121[d121.G==1].x1,d121[d121.G==2].x1)  #x1两类t检验\nprint('变量x1的两类t检验：t=%.4f, p=%.4f'%(t1[0],t1[1]))"
    },
    {
      "index": 16,
      "locator": "Notebook 单元 16 · code",
      "text": "t2=st.ttest_ind(d121[d121.G==1].x2,d121[d121.G==2].x2)  #x2两类t检验\nprint('变量x2的两类t检验：t=%.4f, p=%.4f'%(t2[0],t2[1]))"
    },
    {
      "index": 17,
      "locator": "Notebook 单元 17 · code",
      "text": "#import statsmodels.api as sm\n#Logit=sm.GLM.from_formula(\"C(G)~x1+x2\",d121,family=sm.families.Binomial()).fit()\n#print(Logit.summary().tables[1])"
    },
    {
      "index": 18,
      "locator": "Notebook 单元 18 · code",
      "text": "import matplotlib.pyplot as plt\nplt.plot(d121.x1,d121.x2,'.');plt.xlabel('x1');plt.ylabel('x2')\nfor i in range(0,len(d121.G)):plt.text(d121.x1[i],d121.x2[i],d121.G[i])"
    },
    {
      "index": 19,
      "locator": "Notebook 单元 19 · code",
      "text": "from sklearn.discriminant_analysis import LinearDiscriminantAnalysis as lda #?lda"
    },
    {
      "index": 20,
      "locator": "Notebook 单元 20 · code",
      "text": "X=d121[['x1','x2']]; Y=d121['G']\nd121_lda=lda(priors=(1/2,1/2)).fit(X,Y)\nd121_lda"
    },
    {
      "index": 21,
      "locator": "Notebook 单元 21 · code",
      "text": "d121['ld_G'] = d121_lda.predict(X) #线性判别结果\nprint(d121)"
    },
    {
      "index": 22,
      "locator": "Notebook 单元 22 · code",
      "text": "#tab1=pd.crosstab(d121.G,d121.ld_G,margins=True)  \ntab1=d121.pivot_table('id','G','ld_G',aggfunc=len,margins=True)\nprint('混淆矩阵:\\n',tab1)"
    },
    {
      "index": 23,
      "locator": "Notebook 单元 23 · code",
      "text": "import numpy as np\ndef Rate(tab): #定义计算符合率函数    \n    rate=sum(np.diag(tab)[:-1]/np.diag(tab)[-1:])*100\n    print('符合率: %.2f'%rate)     \nRate(tab1)"
    },
    {
      "index": 24,
      "locator": "Notebook 单元 24 · code",
      "text": "d121_lda.scalings_  #判别系数"
    },
    {
      "index": 25,
      "locator": "Notebook 单元 25 · code",
      "text": "a1=d121_lda.scalings_[0];a2=d121_lda.scalings_[1]\n#y=a1x1+a2x2 ---> x2=1/a2(y-a1x1)  #线性判别方程\na=1/a2*(a1*np.mean(d121.x1)+a2*np.mean(d121.x2)); b =-a1/a2 \nplt.plot(d121.x1,d121.x2,'.');plt.xlabel('x1');plt.ylabel('x2') \nplt.plot(d121.x1,a+b*d121.x1,color='r');#画出判别线\nfor i in range(0,len(d121.G)):plt.text(d121.x1[i],d121.x2[i],d121.G[i])"
    },
    {
      "index": 26,
      "locator": "Notebook 单元 26 · code",
      "text": "print('线性判别分类情况：',d121_lda.predict(pd.DataFrame([[8.1,2.0]]))) "
    },
    {
      "index": 27,
      "locator": "Notebook 单元 27 · markdown",
      "text": "### 12.2.3 非线性判别函数"
    },
    {
      "index": 28,
      "locator": "Notebook 单元 28 · code",
      "text": "from sklearn.discriminant_analysis import QuadraticDiscriminantAnalysis as qda\nd121_qda=qda(priors=(1/2,1/2)).fit(X,Y)\nd121_qda"
    },
    {
      "index": 29,
      "locator": "Notebook 单元 29 · code",
      "text": "d121['qd_G'] = d121_qda.predict(X)  #二次判别结果\nprint(d121)"
    },
    {
      "index": 30,
      "locator": "Notebook 单元 30 · code",
      "text": "#tab2=pd.crosstab(d121.G,d121.qd_G,margins=True);\ntab2=d121.pivot_table('id','G','qd_G',aggfunc=len,margins=True)\nprint('混淆矩阵:\\n',tab2)"
    },
    {
      "index": 31,
      "locator": "Notebook 单元 31 · code",
      "text": "Rate(tab2) "
    },
    {
      "index": 32,
      "locator": "Notebook 单元 32 · code",
      "text": "print('二次判别分类情况：',d121_qda.predict(pd.DataFrame([[8.1,2.0]]))) "
    },
    {
      "index": 33,
      "locator": "Notebook 单元 33 · markdown",
      "text": "### 12.2.4 多总体距离判别"
    },
    {
      "index": 34,
      "locator": "Notebook 单元 34 · code",
      "text": "d123=pd.read_excel('mvsData.xlsx','d123');#d123"
    },
    {
      "index": 35,
      "locator": "Notebook 单元 35 · code",
      "text": "plt.plot(d123.Q,d123.C,'.'); plt.xlabel('Q');plt.ylabel('C')\nfor i in range(0,len(d123.G)): plt.text(d123.Q[i],d123.C[i],d123.G[i])"
    },
    {
      "index": 36,
      "locator": "Notebook 单元 36 · code",
      "text": "plt.plot(d123.Q,d123.P,'.'); plt.xlabel('Q');plt.ylabel('P')\nfor i in range(0,len(d123.G)):plt.text(d123.Q[i],d123.P[i],d123.G[i])"
    },
    {
      "index": 37,
      "locator": "Notebook 单元 37 · code",
      "text": "plt.plot(d123.C,d123.P,'.'); plt.xlabel('C');plt.ylabel('P')\nfor i in range(0,len(d123.G)):plt.text(d123.C[i],d123.P[i],d123.G[i])"
    },
    {
      "index": 38,
      "locator": "Notebook 单元 38 · code",
      "text": "X=d123[['Q','C','P']]; Y=d123.G\nd123_lda=lda(priors=(1/3,1/3,1/3)).fit(X,Y) #等概率\nd123['ld_G'] = d123_lda.predict(X) #线性判别结果\nprint(d123)"
    },
    {
      "index": 39,
      "locator": "Notebook 单元 39 · code",
      "text": "#d123_M1=pd.crosstab(d123.G,d123.ld_G,margins=True); \nM1=d123.pivot_table('id','G','ld_G',aggfunc=len,margins=True,fill_value='0')\nprint('混淆矩阵:\\n',M1)"
    },
    {
      "index": 40,
