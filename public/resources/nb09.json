      "text": "### 9.2.1 简单相关分析"
    },
    {
      "index": 5,
      "locator": "Notebook 单元 5 · code",
      "text": "#%run init.py"
    },
    {
      "index": 6,
      "locator": "Notebook 单元 6 · code",
      "text": "import numpy as np\nnp.set_printoptions(4) \nx=np.array([171,175,159,155,152,158,154,164,168,166,159,164])  #身高向量\ny=np.array([57,64,41,38,35,44,41,51,57,49,47,46])              #体重向量"
    },
    {
      "index": 7,
      "locator": "Notebook 单元 7 · code",
      "text": "%config InlineBackend.figure_format='retina'\nimport matplotlib.pyplot as plt              #加载基本绘图包\nplt.scatter(x,y);                            #做散点图\nplt.xlabel('x');plt.ylabel('y');"
    },
    {
      "index": 8,
      "locator": "Notebook 单元 8 · code",
      "text": "def lxy(x,y):\n    return sum(x*y)-sum(x)*sum(y)/len(x)  #离均差乘积和函数"
    },
    {
      "index": 9,
      "locator": "Notebook 单元 9 · code",
      "text": "lxy(x,x)  #x的离均差平方和"
    },
    {
      "index": 10,
      "locator": "Notebook 单元 10 · code",
      "text": "lxy(y,y)  #y的离均差平方和"
    },
    {
      "index": 11,
      "locator": "Notebook 单元 11 · code",
      "text": "lxy(x,y)  #x和y的离均差乘积和"
    },
    {
      "index": 12,
      "locator": "Notebook 单元 12 · code",
      "text": "r=lxy(x,y)/np.sqrt(lxy(x,x)*lxy(y,y)) ;r  #相关系数计算"
    },
    {
      "index": 13,
      "locator": "Notebook 单元 13 · code",
      "text": "#np.corrcoef(x,y)       #计算相关系数"
    },
    {
      "index": 14,
      "locator": "Notebook 单元 14 · code",
      "text": "n=len(x)                  #向量的长度\ntr=r/np.sqrt((1-r**2)/(n-2))  #相关系数假设检验t统计量\ntr"
    },
    {
      "index": 15,
      "locator": "Notebook 单元 15 · code",
      "text": "#from scipy import stats as st             #加载统计包\nimport scipy.stats as st             #加载统计包\nrp=st.pearsonr(x,y)\nprint('r=%.4f  p-value=%.4g'%(rp[0],rp[1]))"
    },
    {
      "index": 16,
      "locator": "Notebook 单元 16 · markdown",
      "text": "### 9.2.2 简单回归分析"
    },
    {
      "index": 17,
      "locator": "Notebook 单元 17 · code",
      "text": "b=lxy(x,y)/lxy(x,x)             #线性回归方程斜率\na=y.mean()-b*x.mean()           #线性回归方程截距\nprint('a=%.4f  b=%.4f'%(a,b))   #显示线性回归方程估计值"
    },
    {
      "index": 18,
      "locator": "Notebook 单元 18 · code",
      "text": "plt.plot(x,y,'o',x,a+b*x,'-');     #添加估计方程线\nplt.xlabel('x');plt.ylabel('y');"
    },
    {
      "index": 19,
      "locator": "Notebook 单元 19 · code",
      "text": "import pandas as pd                          #加载数据分析包\npd.set_option('display.precision',4)         #设置数据框输出精度\nd93=pd.read_excel('mvsData.xlsx','d93',index_col=0);d93 "
    },
    {
      "index": 20,
      "locator": "Notebook 单元 20 · code",
      "text": "from statsmodels.formula.api import ols   #加载公式法普通最小二乘函数\nfm0=ols('y ~ x',data=d93).fit()           #拟合一元线性回归模型\nfm0.params                                #显示回归参数"
    },
    {
      "index": 21,
      "locator": "Notebook 单元 21 · code",
      "text": "plt.plot(d93.x,d93.y,'o',d93.x,fm0.fittedvalues,'-');  #添加回归线\nplt.xlabel('x');plt.ylabel('y');"
    },
