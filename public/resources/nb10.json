    {
      "index": 14,
      "locator": "Notebook 单元 14 · markdown",
      "text": "## 10.3 典型相关分析原理"
    },
    {
      "index": 15,
      "locator": "Notebook 单元 15 · markdown",
      "text": "### 10.3.1 典型相关的思想"
    },
    {
      "index": 16,
      "locator": "Notebook 单元 16 · markdown",
      "text": "### 10.3.2 典型相关的求法"
    },
    {
      "index": 17,
      "locator": "Notebook 单元 17 · code",
      "text": "X=d101[['x1','x2','x3']]  #第一组数据\nY=d101[['y1','y2','y3']]  #第二组数据"
    },
    {
      "index": 18,
      "locator": "Notebook 单元 18 · code",
      "text": "from sklearn.cross_decomposition import CCA\nimport numpy as np\nn,p=np.shape(X); n,q = np.shape(Y)\nca=CCA(n_components=min(p,q)).fit(X,Y); #取最小变量个数"
    },
    {
      "index": 19,
      "locator": "Notebook 单元 19 · code",
      "text": "from pandas import DataFrame as DF\nu_coef=ca.x_rotations_.T  #X的典型变量系数\nprint(DF(u_coef,['u1','u2','u3'],X.columns))\nv_coef=ca.y_rotations_.T  #Y的典型变量系数\nprint(DF(v_coef,['v1','v2','v3'],Y.columns))"
    },
    {
      "index": 20,
      "locator": "Notebook 单元 20 · code",
      "text": "u_scores,v_scores=ca.transform(X,Y) #典型变量u、v得分\nU=DF(u_scores);V=DF(v_scores)       #典型变量得分数据框\nU,V"
    },
    {
      "index": 21,
      "locator": "Notebook 单元 21 · code",
      "text": "CR=U.corrwith(V);CR                 #典型变量的相关系数"
    },
    {
      "index": 22,
      "locator": "Notebook 单元 22 · markdown",
      "text": "### 10.3.3 典型变量的性质"
    },
    {
      "index": 23,
      "locator": "Notebook 单元 23 · markdown",
      "text": "### 10.3.4 典型相关的检验"
    },
    {
      "index": 24,
      "locator": "Notebook 单元 24 · code",
      "text": "def CR_test(n,p,q,r):  #典型相关检验函数\n    m=len(r); \n    import numpy as np\n    Q=np.zeros(m); P=np.zeros(m)\n    L=1  #lambda=1\n    from math import log\n    for k in range(m-1,-1,-1):  \n        L=L*(1-r[k]**2)  \n        Q[k]=-log(L)\n    from scipy import stats                \n    for k in range(0,m):\n        Q[k]=(n-k-1/2*(p+q+3))*Q[k] #检验的卡方值\n        P[k]=1-stats.chi2.cdf(Q[k],(p-k)*(q-k)) #P值\n    CR=DF({'CR':r,'Q':Q,'P':P}).round(4)\n    return CR"
    },
    {
      "index": 25,
      "locator": "Notebook 单元 25 · code",
      "text": "print(CR_test(n,p,q,CR))"
    },
    {
      "index": 26,
      "locator": "Notebook 单元 26 · markdown",
      "text": "### 10.4 典型相关分析步骤"
    },
    {
      "index": 27,
      "locator": "Notebook 单元 27 · markdown",
      "text": "### 10.4.1 计算典型系数及变量"
    },
    {
      "index": 28,
      "locator": "Notebook 单元 28 · code",
      "text": "def cancor(X,Y,pq=None,plot=False):  #pq指定典型变量的个数\n    import numpy as np\n    n,p=np.shape(X); n,q=np.shape(Y)\n    if pq==None: pq=min(p,q)\n    cca=CCA(n_components=pq).fit(X,Y); \n    u_scores,v_scores=cca.transform(X,Y) \n    r=DF(u_scores).corrwith(DF(v_scores));  \n    CR=CR_test(n,p,q,r)           \n    print('典型相关系数检验：\\n',CR)   \n    print('\\n典型相关变量系数：\\n')\n    u_coef=DF(cca.x_rotations_.T,['u%d'%(i+1) for i in range(pq)],X.columns)\n    v_coef=DF(cca.y_rotations_.T,['v%d'%(i+1) for i in range(pq)],Y.columns)        \n    if plot: #显示第一对典型变量的关系图\n        import matplotlib.pyplot as plt    \n        plt.plot(u_scores[:,0],v_scores[:,0],'o')\n    return u_coef,v_coef"
    },
    {
      "index": 29,
      "locator": "Notebook 单元 29 · code",
      "text": "cancor(X,Y,plot=True)"
    },
    {
      "index": 30,
      "locator": "Notebook 单元 30 · markdown",
