      "locator": "Notebook 单元 128 · code",
      "text": "#定量频数表与直方图函数\ndef freq(X,bins=10):  #默认自动分10组\n    H=plt.hist(X,bins);\n    a=H[1][:-1]; b=H[1][1:];\n    f=H[0]; p=f/sum(f)*100;p\n    cp=np.cumsum(p);cp\n    Freq=pd.DataFrame([a,b,f,p,cp])\n    Freq.index=['[下限','上限)','频数','频率(%)','累计频数(%)']\n    return(round(Freq.T,2))"
    },
